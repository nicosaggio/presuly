# Copiá este archivo a .env.local y completá los valores.

# Neon (Postgres) — connection string del panel de Neon (formato postgresql://...)
DATABASE_URL=

# Generá uno con: openssl rand -base64 32
AUTH_SECRET=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Remitente verificado en Resend. Mientras no verifiques un dominio propio,
# usá el remitente de pruebas: "Presuly <onboarding@resend.dev>" (solo entrega a tu propio email de cuenta).
EMAIL_FROM="Presuly <onboarding@resend.dev>"

# URL pública de la app (sin barra final). En local: http://localhost:3000
APP_URL=http://localhost:3000
