# Copiá este archivo a .env.local y completá los valores.

# Neon (Postgres) — connection string del panel de Neon (formato postgresql://...)
DATABASE_URL=

# Generá uno con: openssl rand -base64 32
AUTH_SECRET=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Remitente verificado en Resend. Mientras no verifiques un dominio propio,
# usá el remitente de pruebas: "Presuly <onboarding@resend.dev>" (solo entrega a tu propio email de cuenta).
EMAIL_FROM="Presuly <onboarding@resend.dev>"

# URL pública de la app (sin barra final). En local: http://localhost:3000
APP_URL=http://localhost:3000

# Paddle — https://vendors.paddle.com (usá una cuenta Sandbox para probar primero)
# API key: Developer Tools > Authentication > Generate API key
PADDLE_API_KEY=
# Webhook secret: Developer Tools > Notifications > tu endpoint > Notification setting
PADDLE_WEBHOOK_SECRET=
# "sandbox" mientras probás, "production" cuando la cuenta esté aprobada para cobrar de verdad
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Client-side token: Developer Tools > Authentication > Client-side tokens
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# IDs de precio creados en Paddle > Catalog > Prices (uno por plan/frecuencia)
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_ANNUAL=
PADDLE_PRICE_STUDIO_MONTHLY=

# Email que puede ver /dashboard/metrics (coeficiente viral k, Fase 3)
ADMIN_EMAIL=

# Token para que un agente/cron llame GET /api/admin/report sin sesión de
# navegador (header "Authorization: Bearer <token>"). Generá uno con:
# openssl rand -base64 32
ADMIN_REPORT_TOKEN=

# Netlify Blobs (adjuntos de presupuestos) — solo hace falta en local. En Netlify
# el contexto se inyecta solo. Site ID: Site configuration > General > Site details.
# Token: User settings > Applications > Personal access tokens > New access token.
NETLIFY_SITE_ID=
NETLIFY_BLOBS_TOKEN=
